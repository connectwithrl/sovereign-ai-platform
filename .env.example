# Copy to .env and adjust. All variables are optional — the defaults run fully offline.

# --- Serving ---------------------------------------------------------------
SOVEREIGN_SERVING_BACKEND=echo            # echo | openai | bedrock
# Production: point at a self-hosted vLLM/TGI OpenAI-compatible endpoint
# SOVEREIGN_SERVING_BACKEND=openai
# SOVEREIGN_OPENAI_BASE_URL=http://vllm:8000/v1
# SOVEREIGN_OPENAI_API_KEY=not-needed-for-local-vllm
# SOVEREIGN_SERVING_MODEL=Qwen/Qwen2.5-7B-Instruct
# Or AWS Bedrock:
# SOVEREIGN_SERVING_BACKEND=bedrock
# SOVEREIGN_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
# SOVEREIGN_AWS_REGION=us-east-1

# --- Embeddings ------------------------------------------------------------
SOVEREIGN_EMBEDDING_BACKEND=hashing       # hashing | openai
SOVEREIGN_EMBEDDING_DIM=256

# --- Vector store ----------------------------------------------------------
# Unset = in-memory store. Set to use PostgreSQL + pgvector:
# SOVEREIGN_DATABASE_URL=postgresql+psycopg://sovereign:sovereign@localhost:5432/sovereign

# --- Retrieval -------------------------------------------------------------
SOVEREIGN_TOP_K=5
SOVEREIGN_RERANK=true

# --- Observability ---------------------------------------------------------
SOVEREIGN_OTEL_ENABLED=false
# SOVEREIGN_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- App -------------------------------------------------------------------
SOVEREIGN_HOST=0.0.0.0
SOVEREIGN_PORT=8000
SOVEREIGN_DEFAULT_LANGUAGE=en             # en | ar